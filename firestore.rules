rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validCatalogId(planId) {
      return planId.matches('coverage_[1-7]_[1-4]_[1-3]') || planId in [
        'cat_1', 'cat_2', 'cat_3', 'cat_4', 'cat_5', 'cat_6', 'cat_7',
        'cat_9', 'cat_10', 'cat_11', 'cat_12', 'cat_13', 'cat_14', 'cat_15',
        'cat_16', 'cat_17', 'cat_18', 'cat_19', 'cat_20', 'cat_21', 'cat_22',
        'cat_23', 'cat_24', 'cat_25', 'cat_26', 'cat_27', 'cat_28', 'cat_29',
        'cat_30', 'cat_31', 'cat_32', 'cat_33', 'cat_34', 'cat_35', 'cat_36',
        'cat_37', 'cat_38'
      ];
    }

    function hasCompletedPlan(planId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/savedPlans/$(planId))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/savedPlans/$(planId)).data.status == 'realizado';
    }

    match /plans/{planId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validCatalogId(planId)
        && request.resource.data.isCatalog == true
        && request.resource.data.title is string
        && request.resource.data.location is string
        && request.resource.data.category in ['Gastronomía', 'Aire Libre', 'Cultura', 'Viajes']
        && request.resource.data.budget is string;
      allow update, delete: if false;

      match /ratings/{userId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && hasCompletedPlan(planId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.value is int
          && request.resource.data.value >= 1
          && request.resource.data.value <= 5;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /users/{userId}/savedPlans/{planId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;

      match /ratings/{ratingUserId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.auth.uid == ratingUserId
          && get(/databases/$(database)/documents/users/$(userId)/savedPlans/$(planId)).data.status == 'realizado'
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.value is int
          && request.resource.data.value >= 1
          && request.resource.data.value <= 5;
        allow delete: if signedIn() && request.auth.uid == userId && request.auth.uid == ratingUserId;
      }
    }

    match /{path=**}/ratings/{ratingId} {
      allow read: if signedIn();
    }
  }
}
