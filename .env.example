# Copiar a .env.local y reemplazar los ejemplos con la configuracion WEB de Firebase.
# No incluir claves privadas, tokens ni cuentas de servicio.
# Para la entrega se requiere Firebase; false activa solo la vista previa local.
VITE_USE_FIREBASE=true
VITE_FIREBASE_API_KEY=REEMPLAZAR_API_KEY_WEB
VITE_FIREBASE_AUTH_DOMAIN=REEMPLAZAR_PROYECTO.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REEMPLAZAR_PROYECTO
VITE_FIREBASE_STORAGE_BUCKET=REEMPLAZAR_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=REEMPLAZAR_SENDER_ID
VITE_FIREBASE_APP_ID=REEMPLAZAR_APP_ID
